# OptiQ - Variables de Entorno del Frontend
# Si estas variables no están definidas, el frontend utilizará automáticamente: http://127.0.0.1:8000/api

# URL del servidor backend FastAPI (puedes incluir o no /api al final)
VITE_API_URL=http://127.0.0.1:8000

# Ejemplo para servidor en la nube / producción:
# VITE_API_URL=https://api.tu-dominio.com
# VITE_API_URL=http://tu-servidor-oracle-cloud:8000
